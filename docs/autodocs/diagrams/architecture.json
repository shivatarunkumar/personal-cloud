  "cards": [
    {
      "dot": "emerald",
      "title": "Primary path: open a file",
      "items": [
        "Browser → Caddy → Next.js → FastAPI → Drive service → PostgreSQL",
        "Listings are database-only: opening the app reads no bytes from GCS",
        "Bytes stream back only on open / play / download, via HTTP Range (206)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Uploads skip the server",
      "items": [
        "API checks name clashes, books the file, opens a resumable session",
        "Browser PUTs 8 MB chunks straight to GCS, 3 files at a time",
        "API confirms the size on complete; the file becomes ready"
      ]
    },
    {
      "dot": "violet",
      "title": "Bucket layout and sync",
      "items": [
        "{username}/{folder path}/{file name}, plus a marker per folder",
        "Trash: _trash/{username}/{deleted at}/{original path}",
        "Every change: database first, then server-side copy, commit, delete old"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Bucket private: uniform access + public access prevention",
        "15-min access JWT + rotating refresh, reuse detection",
        "Every query scoped to the signed-in user; others get 404"
      ]
    },
    {
      "dot": "slate",
      "title": "Operations",
      "items": [
        "cloud.sh runs web + API; cron at boot and every 10 min",
        "Housekeeping: trash > 30 days, abandoned uploads",
        "make setup · check-all · relayout · reindex"
      ]
    }
  ]
}