# Personal Cloud configuration. Copy to .env (never commit .env) and fill in the
# values marked REQUIRED. Every command (make, cloud.sh) reads this file.
# Keep comments on their own lines: inline comments become part of the value.

# ================================================================ app
# The name shown in the web app and the browser tab.
APP_NAME=Personal Cloud
# local allows `make db-reset`; anything else refuses it
APP_ENV=local

# INFO  one line per request, plus decisions worth knowing about
# DEBUG full trace of each call: every SQL statement and GCS call with its duration
LOG_LEVEL=INFO
# text for a terminal, json for machine-read logs
LOG_FORMAT=text
# every SQL statement SQLAlchemy runs: enormous, so opt in when you need it
SQL_ECHO=false

# ================================================================ addresses
# Ports: chosen so this runs next to other local apps on 8000/3000 (and whatever owns 80).
API_HOST_PORT=8002
WEB_HOST_PORT=3002
# Where the web app talks to the API (server side). The browser never uses it.
API_BASE_URL=http://localhost:8002

# The address you open in the browser. Use a friendly name if you like, e.g.
#   WEB_BASE_URL=http://mycloud.com:3002
# `make setup-hosts` maps its hostname to 127.0.0.1 in /etc/hosts. Keep the port unless
# port 80 is free on this machine and WEB_HOST_PORT=80.
# Browser uploads are allowed from this address and from http://localhost:<WEB_HOST_PORT>
# automatically; nothing else to configure.
WEB_BASE_URL=http://localhost:3002

# Optional: more addresses that may open the app, comma-separated, e.g. this machine's
# LAN or Tailscale address for your phone:  http://192.168.1.20:3002
# After changing it run `make setup-gcp` so the bucket accepts uploads from them too.
EXTRA_ORIGINS=

# ================================================================ database (PostgreSQL)
# App connection. `make db-init` creates this role (with this password) and database.
# REQUIRED: choose a password.
DATABASE_URL=postgresql+asyncpg://cloud:change-me@localhost:5432/personal_cloud
# A superuser on the same server, used only by `make db-init` to create the above.
# Homebrew Postgres: your macOS username, no password.
POSTGRES_ADMIN_URL=postgresql://postgres@localhost:5432/postgres
DB_POOL_SIZE=5

# ================================================================ accounts
# REQUIRED. Signs the session cookie. Generate with: openssl rand -hex 32
# Per machine: never copy it into git. The API refuses to start while it is empty.
JWT_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# true: anyone who can open the site can create an account.
# false: /register is switched off (set it once everyone has an account).
ALLOW_SIGNUP=true

# ================================================================ google cloud storage
# REQUIRED. The project that owns the bucket.
GCP_PROJECT_ID=
# REQUIRED. The bucket every file is stored in (it stays private).
GCS_BUCKET=
# Optional sub-path inside the bucket, e.g. personal-cloud/ (keep the trailing slash).
GCS_PREFIX=
# Empty: use your gcloud login (gcloud auth application-default login).
# Or the full path to a service-account key file, kept OUTSIDE this folder.
GOOGLE_APPLICATION_CREDENTIALS=

# ================================================================ limits
# Upload chunk size: a multiple of 256 KiB. 8 MiB suits home connections.
UPLOAD_CHUNK_BYTES=8388608
# Largest single file: 50 GiB
MAX_UPLOAD_BYTES=53687091200
# Storage per new account in bytes; empty = unlimited
DEFAULT_QUOTA_BYTES=
# Items in the trash longer than this are deleted for good by cloud.sh
TRASH_RETENTION_DAYS=30
